# Servicio systemd para Licha.bot. Ver README.md, sección "Dejarlo corriendo 24/7".
# Copialo a /etc/systemd/system/ y ajustá User y las rutas si instalaste en otro lado.

[Unit]
Description=Licha.bot - stickers para WhatsApp
After=network-online.target
Wants=network-online.target
# No dejar de reintentar nunca (por ejemplo, si al arrancar todavía no hay red).
StartLimitIntervalSec=0

[Service]
Type=simple
User=licha
Group=licha
WorkingDirectory=/opt/licha-sticker-bot
EnvironmentFile=/opt/licha-sticker-bot/.env
ExecStart=/opt/licha-sticker-bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
# Código 2 = hay que volver a vincular el número: no reiniciar en bucle
# pidiendo códigos; hacelo a mano (ver README).
RestartPreventExitStatus=2
TimeoutStopSec=20

# Endurecimiento: solo puede escribir en la carpeta de la sesión.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/licha-sticker-bot/data

[Install]
WantedBy=multi-user.target
