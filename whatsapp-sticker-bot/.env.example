# Copiá este archivo como .env y completalo. Las variables de entorno reales
# tienen prioridad sobre lo que diga este archivo.

# Número que va a usar el bot, en formato internacional, solo dígitos y sin '+'.
# Solo hace falta para vincular (la primera vez o si se cierra la sesión).
# Argentina: 54 + 9 + código de área sin 0 + número sin 15 -> 5491123456789
WA_PHONE_NUMBER=

# Archivo SQLite donde se guarda la sesión (relativo a la carpeta del bot).
# ¡Es una credencial! No lo compartas ni lo subas a git.
WA_SESSION_DB=data/session.sqlite3

# Comando que dispara la conversión (sin espacios; no distingue mayúsculas).
STICKER_COMMAND=.sticker

# Marca de Licha.bot: nombre del paquete y autor que muestra WhatsApp al tocar
# el sticker, y texto visible en la esquina (dejalo vacío para no dibujarlo).
STICKER_PACK_NAME=Licha.bot
STICKER_PACK_PUBLISHER=Licha.bot
STICKER_WATERMARK=Licha.bot

# Límites
STICKER_IMAGE_MAX_KB=100
STICKER_ANIMATED_MAX_KB=500
STICKER_MAX_VIDEO_SECONDS=10
MAX_DOWNLOAD_MB=25
MAX_CONCURRENT_CONVERSIONS=2

# Segundos que se espera a que ingreses el código de vinculación.
PAIR_TIMEOUT_SECONDS=180

# DEBUG, INFO, WARNING, ERROR. NEONIZE_LOG_LEVEL controla los logs de la
# librería y de la conexión con WhatsApp.
LOG_LEVEL=INFO
NEONIZE_LOG_LEVEL=WARNING
